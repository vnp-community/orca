# Copy to deploy/tsagent/.env and use --env-file deploy/tsagent/.env. Review over MCP is off, listens on 127.0.0.1 only.
TSAGENT_PORT=8766
TSAGENT_TOKEN=dev-token
# REQUIRED, no default: none (rules only) | anthropic | openai (missing key/model -> immediate error)
# (claude-cli only outside the container, needs a logged-in Claude Code session). Empty -> the container does not start.
TSAGENT_LLM=
TSAGENT_LLM_STEPS=analysis,design,specification
TSAGENT_LLM_CAP_ANALYSIS=200
TSAGENT_LLM_CAP_DESIGN=100
TSAGENT_LLM_CAP_SPEC=300
# number of parallel LLM calls
TSAGENT_LLM_PARALLEL=1
# max retries of a failed LLM group; if more than 50 % of a step's groups still fail, the run fails
TSAGENT_LLM_GROUP_RETRIES=2
# auto-approval policy for LLM nodes, e.g. classes=TestStep,Assertion;min_confidence=0.9 (empty = off)
TSAGENT_AUTO_APPROVE=
# 1 = enable approve_nodes/reject_nodes/baseline_spec over MCP (the minipay workflow needs it)
TSAGENT_MCP_REVIEW=0
TSAGENT_MAX_BODY_KB=4096
TSAGENT_ALLOWED_ORIGINS=
# source documents folder mounted at /data/sources (start_run.paths only reads in there)
TSAGENT_SOURCES_DIR=../../tests/testspec_agent/fixtures
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
# Outside the container: TSAGENT_DB, TSAGENT_SPECS_ROOT, TSAGENT_CACHE_DIR, TSAGENT_SNAPSHOT_DIR, TSAGENT_INBOX_DIR,
# TSAGENT_SOURCE_ROOTS, TSAGENT_BUSY_TIMEOUT_MS, TSAGENT_CONTEXT_DEPTH, TSAGENT_CONTEXT_MAX_CHARS, TSAGENT_CLAUDE_MODEL, CLAUDE_BIN
