{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tdd:quality:ValidatorExecution:1.0.0",
  "type": "object",
  "properties": {
    "rule_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "input_hash": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "enum": [
        "pass",
        "fail",
        "error",
        "unknown",
        "not_applicable"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1
    }
  },
  "required": [
    "rule_id",
    "version",
    "input_hash",
    "outcome",
    "evidence"
  ],
  "additionalProperties": true
}
