{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/tdd/schema/TddGenerationRequest-v0.5",
  "title": "TDD generation request",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "mode", "scope", "sources"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["initial", "change-request", "enhancement", "defect"]},
    "scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "sources": {"type": "array", "items": {"type": "object", "required": ["id", "kind", "version"]}},
    "base_snapshot": {"type": ["string", "null"]},
    "change_request": {"type": ["object", "null"]},
    "workflow_context": {"type": ["object", "null"], "description": "CR/SRS/SAD/approved-impact/realized-TDD stage gate"},
    "profile_id": {"type": "string"},
    "budget": {"type": "object", "properties": {"max_items": {"type": "integer", "minimum": 1}}}
  }
}
