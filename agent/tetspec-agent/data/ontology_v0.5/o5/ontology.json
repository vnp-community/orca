{
  "version": "0.6.0",
  "canonical_release": {
    "version": "0.6.0",
    "status": "active_runtime",
    "compatibility_runtime": "0.5.0",
    "deprecates": "0.5.0",
    "cutover_date": "2026-10-07",
    "source_versions": ["0.4.0", "0.5.0"],
    "fixture": "fixtures/migration-v06-cases.json",
    "acceptance": {
      "runtime_contract": "passed",
      "migration": "passed",
      "authoring_quality": "pending_human_review",
      "evidence": "data/test-pbom/run-quality-v6-authoring/benchmark.result.v6.json"
    },
    "requires": [
      "complete_legacy_new_inventory",
      "typed_quantity_and_evidence_contract",
      "loss_report_and_exact_rollback",
      "independent_semantic_acceptance"
    ]
  },
  "base": {
    "version": "0.4.0",
    "compatibility_versions": ["0.5.0"],
    "classes_source": "../../ontology_v0.4/o4/classes.yaml",
    "relations_source": "../../ontology_v0.4/o4/relations.yaml",
    "legacy_relations_passthrough": true
  },
  "property_aliases": {
    "path_or_name": "path",
    "authn": "auth",
    "concurrency_control": "concurrency",
    "measurement_ref": "measurement"
  },
  "typed_contracts": {
    "Quantity": {
      "value": "number",
      "unit": "non_empty_string",
      "stage": ["target", "budget", "observed", "measured", "assumed"]
    },
    "Evidence": {
      "kind": ["extracted", "derived", "proposed", "prompt"],
      "source_id": "non_empty_string",
      "source_version": "non_empty_string",
      "source_hash": "non_empty_string",
      "anchor": "non_empty_string",
      "quote_hash": "non_empty_string"
    }
  },
  "legacy_required_properties": {
    "Algorithm": ["inputs", "outputs", "deterministic"]
  },
  "maturity_policy": {
    "values": ["sketch", "specified", "verified", "baselined"],
    "requirements": {
      "sketch": [],
      "specified": ["origin", "maturity", "version_introduced", "provenance"],
      "verified": ["origin", "maturity", "version_introduced", "provenance", "review_status"],
      "baselined": ["origin", "maturity", "version_introduced", "provenance", "review_status"]
    }
  },
  "conditional_requirements": [
    {"id": "operation-write-contract", "class": "Operation", "when": {"property": "method", "in": ["POST", "PUT", "PATCH", "DELETE"]}, "required": ["idempotency", "concurrency"]},
    {"id": "operation-transaction-contract", "class": "Operation", "when": {"property": "transactional", "equals": true}, "required": ["timeout", "retry", "failure_policy"]},
    {"id": "measurement-source-contract", "class": "Measurement", "when": {"property": "stage", "in": ["observed", "measured"]}, "required": ["observed_at", "source_ref"]}
  ],
  "classes": {
    "DocumentRef": {
      "required": ["id", "role", "revision", "content_hash"]
    },
    "SectionRef": {
      "required": ["id", "document_id", "role", "revision", "content_hash", "section_id"]
    },
    "SrsDelta": {
      "required": ["id", "cr_id", "before_revision", "after_revision", "sections"]
    },
    "ImpactReport": {
      "required": ["id", "cr_ref", "srs_ref", "sad_ref", "baseline_tdd_snapshot", "entries", "findings", "status"]
    },
    "ImpactApproval": {
