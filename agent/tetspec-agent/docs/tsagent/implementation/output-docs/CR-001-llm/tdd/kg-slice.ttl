<https://example.org/project/AD-05> a <https://example.org/tdd#Decision> ;
    <https://example.org/tdd#code> "AD-05" ;
    <https://example.org/tdd#label> "Scheduler polling trong tiến trình, chu kỳ 30 giây, chiếm lần chạy bằng UPDATE có điều kiện" ;
    <https://example.org/tdd#rationale> "Tuân CON-010, không thêm hạ tầng; chu kỳ 30 giây đủ cho NFR-010 (60 giây); UPDATE có điều kiện chống chạy trùng (NFR-011)" ;
    <https://example.org/tdd#sourceDoc> "TDD" ;
    <https://example.org/tdd#sourceSection> "Quyết định" ;
    <https://example.org/tdd#statement> "Scheduler là vòng lặp nền trong tiến trình MiniPay, quét lần chạy đến hạn mỗi 30 giây và chiếm lần chạy bằng UPDATE có điều kiện" ;
    <https://example.org/tdd#status> "Baselined" ;
    <https://example.org/tdd#version> "0.1" ;
    <https://example.org/tdd#assumes> <https://example.org/project/ASM-010> ;
    <https://example.org/tdd#constrainedBy> <https://example.org/project/CON-010> ;
    <https://example.org/tdd#describedIn> <https://example.org/project/DOC-HLD> ;
    <https://example.org/tdd#hasRisk> <https://example.org/project/RISK-005> ;
    <https://example.org/tdd#rejects> <https://example.org/project/ALT-APScheduler> ;
    <https://example.org/tdd#rejects> <https://example.org/project/ALT-DelayedQueue> ;
    <https://example.org/tdd#rejects> <https://example.org/project/ALT-OSCron> .
