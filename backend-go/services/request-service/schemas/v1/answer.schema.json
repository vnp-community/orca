{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orca.local/schemas/v1/answer.schema.json",
  "title": "Question answer document",
  "type": "object",
  "required": ["schema_version", "answer_markdown"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "kind": { "const": "answer" },
    "answer_markdown": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref"],
        "additionalProperties": false,
        "properties": {
          "ref": { "type": "string", "minLength": 1 },
          "excerpt": { "type": "string" }
        }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "suggested_follow_up": {
      "type": "object",
      "required": ["type", "title"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["change_request", "task"] },
        "title": { "type": "string", "minLength": 1 }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "blocking"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^Q-[1-9][0-9]*$" },
          "text": { "type": "string", "minLength": 1 },
          "blocking": { "type": "boolean" }
        }
      }
    }
  }
}
