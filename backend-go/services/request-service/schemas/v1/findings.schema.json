{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orca.local/schemas/v1/findings.schema.json",
  "title": "Spike findings document",
  "type": "object",
  "required": ["schema_version", "question", "summary", "findings"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "kind": { "const": "findings" },
    "question": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "statement"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "required": ["type", "ref"],
              "additionalProperties": false,
              "properties": {
                "type": { "enum": ["file", "doc", "command"] },
                "ref": { "type": "string", "minLength": 1 },
                "excerpt": { "type": "string", "maxLength": 600 }
              }
            }
          }
        }
      }
    },
    "recommendation": {
      "type": "object",
      "required": ["statement"],
      "additionalProperties": false,
      "properties": {
        "statement": { "type": "string", "minLength": 1 },
        "reason": { "type": "string" }
      }
    },
    "follow_ups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "suggested_type"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "suggested_type": { "enum": ["change_request", "task"] },
          "reason": { "type": "string" },
          "body": { "type": "string" }
        }
      }
    },
    "unknowns": { "type": "array", "items": { "type": "string" } },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "blocking"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^Q-[1-9][0-9]*$" },
          "text": { "type": "string", "minLength": 1 },
          "blocking": { "type": "boolean" }
        }
      }
    }
  }
}
