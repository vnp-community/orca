# Cấu hình kiểm tra MCP — sao chép thành tests/mcp/.env (file .env đã nằm trong .gitignore).
# Biến môi trường shell ghi đè file này. Nếu thiếu ORCA_ADMIN_*, dùng BOOTSTRAP_ADMIN_* trong deploy/dev/.env.

# api-gateway (REST /auth, /v1 và /ws). Mặc định: MCP_PUBLIC_BASE_URL / PUBLIC_BASE_URL trong deploy/dev/.env.
ORCA_API_BASE_URL=http://localhost:6768
# Endpoint MCP (mặc định <ORCA_API_BASE_URL>/mcp) và /ws (suy ra từ ORCA_API_BASE_URL).
ORCA_MCP_URL=
ORCA_WS_URL=

# Tài khoản admin: đăng nhập để tạo PAT tạm, gọi kênh mcp.admin.* và dọn dữ liệu.
ORCA_ADMIN_EMAIL=admin@example.com
ORCA_ADMIN_PASSWORD=change-me
# (tuỳ chọn) Người dùng thường: kiểm tra phân quyền admin và scope orca:admin.
ORCA_USER_EMAIL=
ORCA_USER_PASSWORD=

# (tuỳ chọn) PAT dựng sẵn, dùng khi không có tài khoản đăng nhập. Không biết scope chính xác nên
# một số kiểm tra theo scope có thể không đúng. Không bao giờ commit giá trị thật.
ORCA_MCP_TOKEN=

# (tuỳ chọn) Origin nằm trong MCP_ALLOWED_ORIGINS của gateway — kiểm tra Origin hợp lệ được chấp nhận.
ORCA_MCP_ALLOWED_ORIGIN=
# (tuỳ chọn) Project dùng cho luồng task; để trống thì lấy project đầu tiên của project_list.
ORCA_MCP_PROJECT_ID=

# true: MCP phải đang bật (preflight FAIL nếu /.well-known trả 404). false: cố ý tắt, các suite tự SKIP.
ORCA_MCP_EXPECT_ENABLED=true
# false: không ghi dữ liệu (bỏ luồng task và vòng đời token).
ORCA_ALLOW_WRITES=true
# true: gọi task_execute thật (cần dev server kết nối; tạo yêu cầu phê duyệt cho người duyệt trong Settings → MCP → Approvals).
ORCA_MCP_PROBE_EXEC=false
# Thời gian tối đa chờ PAT đã thu hồi bị chặn (giây). 0 = bỏ qua.
ORCA_MCP_REVOKE_WAIT_S=75

ORCA_HTTP_TIMEOUT=20
ORCA_VERIFY_TLS=true
ORCA_TEST_PREFIX=mcptest

# --- Bộ thử nghiệm task (tests/mcp/task) -----------------------------------------------------------
# Project thử nghiệm: tên, hoặc uuid (uuid ưu tiên; dùng khi token không phải thành viên nên project không có trong project_list).
ORCA_MCP_TASK_PROJECT=Vnp-asm
ORCA_MCP_TASK_PROJECT_ID=
ORCA_MCP_TASK_TITLE=Task thử nghiệm qua MCP
# true: thực sự gọi task_execute (cần MCP_TOOL_PACKS_ENABLED=1,2,3, dev server kết nối và người duyệt trong Approvals).
ORCA_MCP_TASK_EXECUTE=false
ORCA_MCP_TASK_PROMPT=
ORCA_MCP_TASK_WAIT_S=180
ORCA_MCP_TASK_POLL_S=6
# true: không xoá task thử nghiệm của suite lifecycle sau khi chạy (để xem trên giao diện).
ORCA_MCP_TASK_KEEP=false
