def tr(lang, key, en, **kw):
    """The Vietnamese text of `key` when the prompt asked for Vietnamese, else the English text unchanged."""
    return VI[key].format(**kw) if lang == "vi" else en


def solution_answer(prompt):
    block = request_block(prompt)
    note = revision_note(prompt)
    lang = language_directive(prompt)
    title = request_field(block, "title")[:80] or "the request"
    m = re.search(r"Give at least (\d+) options", prompt)
    count = min(4, max(2, int(m.group(1)) if m else 2))
    options = []
    for i in range(1, count + 1):
        options.append({
            "id": f"opt-{i}",
            "title": tr(lang, "opt_extend" if i == 1 else "opt_new", f"Option {i}: {'extend the existing module' if i == 1 else 'add a dedicated component'}", i=i),
            "summary": tr(lang, "opt_summary", f"Fake-claude option {i} for: {title}{note}", i=i, title=title, note=note),
            "approach": tr(lang, "opt_approach", f"1. Change the code path that serves \"{title}\".\n2. Cover it with tests.\n3. Roll out behind a flag.", title=title),
            "pros": [tr(lang, "pro_small" if i == 1 else "pro_clear", "Small blast radius" if i == 1 else "Clear separation")],
            "cons": [tr(lang, "con_coupled" if i == 1 else "con_more", "Couples to current code" if i == 1 else "More code to maintain")],
            "risks": [{"description": tr(lang, "risk", "Regression in adjacent behaviour"), "severity": "low"}],
            "effort": {"size": "S" if i == 1 else "M", "hours_estimate": 4 * i},
            "affected_areas": [{"kind": "service", "name": "request-service"}],
            "breaking_change": False,
            "rollback": tr(lang, "rollback", "Revert the change."),
            "recommended": i == 1,
        })
    ids = [o["id"] for o in options]
    doc = {
        "schema_version": 1,
        "options": options,
        "recommendation": {"option_id": "opt-1", "reason": tr(lang, "recommendation", "Smallest change that meets the request.")},
        "assumptions": [{"id": "A-1", "text": tr(lang, "assumption", "The current behaviour is covered by tests."), "needs_confirmation": False}],
        "open_questions": blocking_questions(block, prompt),
        "requirement_coverage": [{"ac_id": ac, "option_ids": ids, "status": "covered", "note": ""} for ac in acceptance_ids(block)],
    }
    return doc


def blocking_questions(block, prompt):
    if BLOCKING_QUESTION_TRIGGER not in block or has_answered_clarifications(prompt):
        return []
    return [{"id": "Q-1", "text": tr(language_directive(prompt), "question", "Which health signal should the badge be driven by?"), "blocking": True}]


def plan_revision_note(prompt):
    """" [revised, round N, asked: <feedback>]" for a Plan prompt with a reviewer's <feedback>, else "". N is one more than the highest round in the
    <prior_plan> block (the previous version's notes), 2 when that block has none, so each version of one Request reads differently."""
    feedback = revision_feedback(prompt)
    if not feedback:
        return ""
    after = prompt.split("\n</request>\n", 1)[1]
    prior = after.split("<prior_plan>", 1)[1] if "<prior_plan>" in after else ""
    rounds = [int(n) for n in re.findall(r"\[revised, round (\d+)", prior)]
    return f" [revised, round {max(rounds) + 1 if rounds else 2}, asked: {' '.join(feedback.split())[:60]}]"


def plan_answer(prompt):
    block = request_block(prompt)
    rtype = request_field(block, "type")
    lang = language_directive(prompt)
    title = request_field(block, "title")[:80] or "the request"
    phased = "Split the work into phases" in prompt

    def task(name, desc, deps=None, labels=None, irreversible=False):
        return {"title": name, "description": desc, "task_type": "task", "estimated_hours": 2,
                "depends_on_indices": deps or [], "labels": labels or [], "irreversible": irreversible}

    first, last = [], []  # labels the per-type rules of BuildPlanPrompt ask for on the first and the last task
    if rtype in ("bug", "security"):
        last = ["test:regression"]
    elif rtype == "performance":
        first, last = ["check:baseline"], ["check:after"]
    elif rtype == "refactor":
        first, last = ["check:tests_before"], ["check:tests_after"]

    def chain(prefix):
        if rtype == "hotfix":  # the hotfix policy accepts exactly one task and no phases
            return [task(prefix + tr(lang, "t_fix", "Fix"), tr(lang, "t_fix_desc", f"Apply the fix for: {title}. Done when the production symptom is gone.", title=title))]
        if rtype == "ops_request":  # runbook: an irreversible step, then a rollback task ordered after it
            return [
                task(prefix + tr(lang, "t_prepare", "Prepare"), tr(lang, "t_prepare_ops_desc", f"Prepare the change for: {title}. Done when the preconditions are checked.", title=title)),
                task(prefix + tr(lang, "t_apply", "Apply"), tr(lang, "t_apply_desc", "Apply the change. Done when the service reports the new state."), deps=[0], irreversible=True),
                task(prefix + tr(lang, "t_rollback", "Rollback"), tr(lang, "t_rollback_desc", "Restore the previous state. Done when the service answers as before the change."), deps=[1], labels=["rollback"]),
            ]
        return [
            task(prefix + tr(lang, "t_prepare", "Prepare"), tr(lang, "t_prepare_desc", f"Prepare the change for: {title}. Done when the branch builds.", title=title), labels=first),
            task(prefix + tr(lang, "t_implement", "Implement"), tr(lang, "t_implement_desc", "Implement the change. Done when the unit tests for it pass."), deps=[0]),
            task(prefix + tr(lang, "t_verify", "Verify"), tr(lang, "t_verify_desc", "Verify the change end to end. Done when the acceptance criteria are demonstrated."), deps=[1], labels=last),
        ]

    notes = tr(lang, "plan_notes", "Deterministic fake-claude plan.")
    if "<feedback>" in prompt:
        notes += tr(lang, "plan_notes_revised", " Revised after reviewer feedback.") + plan_revision_note(prompt)
    plan = {"title": tr(lang, "plan_title", f"Plan: {title}", title=title)[:200], "summary": tr(lang, "plan_summary", "Fake-claude work plan."), "notes": notes}
    if phased:
        plan["tasks"] = []
        plan["phases"] = [
            {"title": tr(lang, "ph1_title", "Phase 1: Foundation"), "description": tr(lang, "ph1_desc", "Ship the groundwork. Done when it is reviewable on its own."),
             "depends_on_phase_indices": [], "tasks": chain("P1 ")},
            {"title": tr(lang, "ph2_title", "Phase 2: Rollout"), "description": tr(lang, "ph2_desc", "Enable the change. Done when it is released."),
             "depends_on_phase_indices": [0], "tasks": chain("P2 ")},
        ]
    else:
        plan["tasks"] = chain("")
        plan["phases"] = []
    return plan


def readonly_kind(prompt):
    """diagnosis | findings | answer, from the schema the prompt asks for (read before <request>, which is untrusted)."""
    head = prompt.split("\n<request>\n", 1)[0]  # the instructions also say "described in <request>", so match the block's own line
    for kind in ("diagnosis", "findings", "answer"):
        if f'"kind":"{kind}"' in head:
            return kind
    return ""


def readonly_answer(prompt, kind):
    block = request_block(prompt)
    lang = language_directive(prompt)
    title = request_field(block, "title")[:80] or "the request"
    note = revision_note(prompt)
    # No file is claimed: the fixture reads nothing, and evidence must not pretend it did.
    evidence = [{"type": "command", "ref": "fake-claude", "excerpt": "Deterministic fixture; no repository file was read."}]
    if kind == "diagnosis":
        return {
            "schema_version": 1, "kind": "diagnosis", "summary": tr(lang, "diag_summary", f"Fake-claude diagnosis for: {title}{note}", title=title, note=note),
            "root_cause": {"statement": tr(lang, "diag_root", f"Fixture root cause for: {title}", title=title), "confidence": 0.5, "evidence": evidence},
            "reproduction": {"reproducible": "unknown", "steps": [], "notes": tr(lang, "diag_repro", "Not reproduced by the fixture.")},
            "impact": {"severity": "low", "scope": "fixture", "affected_components": [], "user_facing": False, "data_risk": False},
            "fix_directions": [{"id": "fix-1", "summary": tr(lang, "diag_fix", "Apply the smallest fix and add a regression test."), "risk": "low"}],
            "suggested_size": "S", "suggest_escalate_to_change_request": False, "open_questions": [],
        }
    if kind == "findings":
        return {
            "schema_version": 1, "kind": "findings", "question": title, "summary": tr(lang, "find_summary", f"Fake-claude findings for: {title}{note}", title=title, note=note),
            "findings": [{"id": "f-1", "statement": tr(lang, "find_statement", "The fixture found nothing to report."), "confidence": 0.5, "evidence": evidence}],
            "recommendation": {"statement": tr(lang, "find_reco", "No follow-up needed."), "reason": tr(lang, "find_reason", "Fixture answer.")},
            "follow_ups": [], "unknowns": [],
        }
    return {
        "schema_version": 1, "kind": "answer",
        "answer_markdown": tr(lang, "answer", f"Fake-claude answer for: {title}. This is a deterministic fixture.{note}", title=title, note=note),
        "confidence": 0.5, "citations": [], "limitations": [tr(lang, "limitation", "Fixture answer; no repository was read.")],
    }


def execution_nonce(prompt):
    """The nonce of the result block a task-execution prompt asks for, or "". The instruction line is the platform's own text at the
    end of the prompt, so only what follows its last occurrence is read (the task text is untrusted and may quote a block)."""
    at = prompt.rfind(EXECUTE_INSTRUCTION)
    if at < 0:
        return ""
    m = re.search(r"^ORCA_RESULT_BEGIN ([A-Za-z0-9]{16,64})$", prompt[at:], re.M)
    return m.group(1) if m else ""


def execution_answer(prompt):
    """The reply text of a task run: a short line, then one valid `done` block. No file is changed or claimed. A passing check is listed
    only when the prompt demands one, and says it is the fixture's."""
    nonce = execution_nonce(prompt)
    if not nonce:  # a plain run: task-service takes exit 0 as success and reads no block
        return "Fake-claude ran the task (deterministic fixture; no file was changed).\n"
    checks = [{"id": "fake-claude: no command was run", "exit": 0}] if REQUIRE_CHECK_LINE in prompt[prompt.rfind(EXECUTE_INSTRUCTION):] else []
    result = {"schema_version": 1, "status": "done", "summary": "Fake-claude finished the task (deterministic fixture; no file was changed).",
              "files_changed": [], "checks_run": checks, "questions": [], "notes": ""}
    return f"Fake-claude ran the task.\nORCA_RESULT_BEGIN {nonce}\n{json.dumps(result)}\nORCA_RESULT_END {nonce}\n"


def main():
    argv = sys.argv[1:]
    if not argv or argv[0] in ("--version", "-v", "-V"):
        record("version", argv)
        sys.stdout.write(f"{VERSION} (Claude Code)\n")
        return 0
    if argv[0] in ("--help", "-h"):
        record("help", argv)
        sys.stdout.write(HELP)
        return 0
    if argv[0] == "auth":
        record("auth", argv)
        ok = logged_in()
        sys.stdout.write(json.dumps({"loggedIn": ok, "authMethod": "fake" if ok else "none", "apiProvider": "firstParty"}) + "\n")
        return 0 if ok else 1  # the real CLI exits 1 when logged out

    if "-p" not in argv and "--print" not in argv:
        record("unsupported", argv)
        sys.stderr.write("fake claude: only -p/--print, --version, --help and `auth status` are supported\n")
        return 2
    if "--print" in argv:
        return run_print_arg(argv)
    return run_print_stdin(argv)


def run_print_stdin(argv):
    """ai.complete: `claude -p --output-format json --tools ""`, prompt on stdin, JSON envelope on stdout."""
    prompt = sys.stdin.read()
    tools = flag_value(argv, "--tools")
    record("print", argv, len(prompt.encode("utf-8")), {"mode": "stdin", "tools": tools, "systemPrompt": flag_value(argv, "--system-prompt"),
                                                         "promptKind": prompt_kind(prompt), "outputLanguage": language_directive(prompt),
                                                         "prompt": prompt[:6000]})  # test fixture only: lets a failing run be diagnosed
    if not logged_in():
        return emit("Not logged in \u00b7 Please run /login", is_error=True, api_status=None, prompt_len=len(prompt))
    if tools != "":
        # The untrusted prompt must never get tools: fail the call so an agent regression is visible in the suite.
        return emit("fake claude: refusing to run without --tools \"\"", is_error=True, prompt_len=len(prompt))
    kind = prompt_kind(prompt)
    if kind in ("solution", "plan") and fail_once(prompt):
        return emit("fake claude: scripted one-time failure", is_error=True, prompt_len=len(prompt))
    if kind in ("solution", "plan"):
        pause_if_slow(prompt)
    if kind == "plan":
        failure = fail_plan_next()
        if failure == "error":
            return emit("fake claude: scripted Plan failure (fail_plan_next)", is_error=True, prompt_len=len(prompt))
        if failure == "invalid":
            return emit("This is not a JSON plan (fail_plan_next).", prompt_len=len(prompt))
        if failure == "slow":
            time.sleep(slow_seconds())
    if kind == "classification":
        body = classify_answer(prompt)
    elif kind == "solution":
        body = solution_answer(prompt)
    elif kind == "plan":
        body = plan_answer(prompt)
    else:
        return emit("fake claude: no canned answer for this prompt", is_error=True, prompt_len=len(prompt))
    return emit(json.dumps(body, ensure_ascii=False), prompt_len=len(prompt))


def stream_event(event):
    write_utf8(json.dumps(event, ensure_ascii=False) + "\n")


def stream_result(text, is_error=False):
    """The `result` event of `--output-format stream-json`: `result` holds what text mode would have printed."""
    stream_event({"type": "result", "subtype": "success", "is_error": is_error, "duration_ms": 1, "num_turns": 1, "result": text,
                  "session_id": SESSION_ID, "usage": {"input_tokens": 1, "output_tokens": max(1, len(text) // 4)}})


def run_print_arg(argv):
    """agent.execPrompt: `claude --print <prompt> [flags]`, cwd is the project's repo. Plain text on stdout (no JSON envelope), or
    one JSON event per line with `--output-format stream-json --verbose`."""
    i = argv.index("--print")
    in_argv = i + 1 < len(argv) and not argv[i + 1].startswith("--")
    # Since CR-REQ-042 the agent sends the prompt on stdin; the argv form stays for the rollback switch.
    prompt = argv[i + 1] if in_argv else sys.stdin.read()
    tools = flag_value(argv, "--tools")
    mode = flag_value(argv, "--permission-mode")
    output_format = flag_value(argv, "--output-format") or "text"
    verbose = "--verbose" in argv
    kind = prompt_kind(prompt)
    record("print", argv, 0 if in_argv else len(prompt.encode("utf-8")), {"mode": "arg" if in_argv else "print-stdin", "tools": tools, "permissionMode": mode, "promptKind": kind,
                                                         "outputFormat": output_format, "verbose": verbose,
                                                         "outputLanguage": language_directive(prompt), "dangerousSkip": BYPASS_FLAG in argv,
                                                         "gitWorktree": os.path.exists(os.path.join(os.getcwd(), ".git")),
                                                         "prompt": prompt[:6000]})  # test fixture only: lets a failing run be diagnosed
    if output_format not in ("text", "stream-json"):
        sys.stderr.write(f"fake claude: --output-format {output_format!r} is not supported with a prompt in argv\n")
        return 1
    if output_format == "stream-json" and not verbose:
        sys.stderr.write("Error: When using --print, --output-format=stream-json requires --verbose\n")  # the real CLI refuses the same way
        return 1
    streaming = output_format == "stream-json"
    if streaming:
        stream_event({"type": "system", "subtype": "init", "cwd": os.getcwd(), "session_id": SESSION_ID, "model": MODEL,
                      "tools": sorted(t for t in (tools or "").split(",") if t), "permissionMode": mode or "default"})
    if not logged_in():
        if streaming:
            stream_result("Not logged in \u00b7 Please run /login", is_error=True)
        else:
            sys.stdout.write("Not logged in \u00b7 Please run /login\n")
        return 1
    if tools is not None and not set(t for t in tools.split(",") if t) <= READONLY_TOOLS:
        sys.stderr.write(f"fake claude: refusing, --tools {tools!r} contains a tool that can write\n")
        return 1
    if kind == "execute":
        return run_execute(prompt, streaming)
    if not kind.startswith("readonly:"):
        sys.stderr.write("fake claude: no canned answer for this prompt\n")
        return 1
    if BYPASS_FLAG in argv:
        sys.stderr.write(f"fake claude: refusing, a read-only analysis must not carry {BYPASS_FLAG}\n")
        return 1
    if fail_once(prompt):
        sys.stderr.write("fake claude: scripted one-time failure\n")
        return 1
    pause_if_slow(prompt)
    body = readonly_answer(prompt, kind.split(":", 1)[1])
    if streaming:
        # No tool event: the fixture reads nothing, and the activity stream must not pretend it did.
        stream_event({"type": "assistant", "message": {"role": "assistant", "content": [
            {"type": "text", "text": "Analysing the request (deterministic fixture, no repository file is read)."}]}, "session_id": SESSION_ID})
        stream_result(json.dumps(body, ensure_ascii=False))
        return 0
    write_utf8(json.dumps(body, ensure_ascii=False) + "\n")
    return 0


def run_execute(prompt, streaming):
    """agent.execPrompt with accessMode=write (task.execute): the prompt ends with the result-block instruction."""
    text = execution_answer(prompt)
    if streaming:
        stream_event({"type": "assistant", "message": {"role": "assistant", "content": [
            {"type": "text", "text": "Running the task (deterministic fixture, no file is changed)."}]}, "session_id": SESSION_ID})
        stream_result(text)
        return 0
    write_utf8(text)
    return 0


def prompt_kind(prompt):
    # startswith, not `in`: request text is untrusted and may quote another prompt's opening line.
    for mark, kind in ((PLAN_MARK, "plan"), (SOLUTION_MARK, "solution"), (CLASSIFY_MARK, "classification")):
        if prompt.startswith(mark):
            return kind
    if prompt.startswith(READONLY_MARK) and readonly_kind(prompt):
        return "readonly:" + readonly_kind(prompt)
    body = prompt[prompt.index("\n\n", len(CONTEXT_PREAMBLE)) + 2:] if prompt.startswith(CONTEXT_PREAMBLE) and "\n\n" in prompt[len(CONTEXT_PREAMBLE):] else prompt
    if execution_nonce(prompt) or body.startswith(EXECUTE_OPENER):
        return "execute"
    return "unknown"


if __name__ == "__main__":
    sys.exit(main())
