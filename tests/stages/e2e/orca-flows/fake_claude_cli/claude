# First match wins. Phrases are specific on purpose: the e2e suite titles its Requests "matrix hotfix", "matrix security" and so
# on only to label them, and must not make the AI propose a type that needs a human approver (hotfix, security).
TYPE_KEYWORDS = [
    ("hotfix", ("production is down", "outage", "urgent production")),
    ("security", ("vulnerab", "cve-", "exploit")),
    ("bug", ("crash", "broken", "regression", "error when")),
    ("performance", ("slow", "latency", "performance regression")),
    ("refactor", ("restructure the", "refactor the")),
    ("docs", ("documentation", "readme")),
    ("ops_request", ("rotate the", "provision a")),
    ("spike", ("investigate", "time-boxed")),
    ("question", ("how do ", "how does ", "what is ")),
    ("change_request", ("new feature", "add support for")),
]


def classify_answer(prompt):
    m = re.search(r"title: ([^\n]*)\nissue_type:[^\n]*\nlabels:[^\n]*\nbody:\n(.*?)\n<<<REQUEST_DATA_", prompt, re.S)
    text = ((m.group(1) + " " + m.group(2)) if m else prompt).lower()
    typ = next((t for t, words in TYPE_KEYWORDS if any(w in text for w in words)), "task")
    urgency = "urgent" if typ == "hotfix" or "urgent" in text else "normal"
    size = {"change_request": "M", "hotfix": "S", "task": "S"}.get(typ, "S")
    return {"type": typ, "size": size, "urgency": urgency, "confidence": 0.8, "reason": "Deterministic fake-claude classification by keyword."}


def request_block(prompt):
    m = re.search(r"<request>\n(.*?)\n</request>", prompt, re.S)
    return m.group(1) if m else ""


def request_field(block, name):
    m = re.search(r"^" + name + r": (.*)$", block, re.M)
    return m.group(1).strip() if m else ""


def acceptance_ids(block):
    return re.findall(r"^- (AC-\d+): ", block, re.M)


# A Request whose title or text contains this code makes the FIRST Solution carry one blocking open question; once the
# prompt holds a <clarifications> block (the reviewer answered it), the regenerated Solution has none. Lets the UI suite
# exercise "ask back" deterministically.
BLOCKING_QUESTION_TRIGGER = "[stub:blocking-question]"


def has_answered_clarifications(prompt):
    # The block follows </request> (BuildSolutionPrompt); the request text is untrusted and the real prompt escapes a quoted
    # closing tag, so only what comes after the first "</request>" line can be the platform's own block.
    after = prompt.split("\n</request>\n", 1)
    return len(after) == 2 and "\n<clarifications>\n" in after[1]


def revision_feedback(prompt):
    """The reviewer's change request in the prompt, or "". Only what follows </request> is read (the request text is untrusted
    and may quote these tags)."""
    after = prompt.split("\n</request>\n", 1)
    if len(after) != 2:
        return ""
    m = re.search(r"\n<feedback>\n[^\n]*\n(.*?)\n</feedback>\n", after[1], re.S)
    return m.group(1) if m else ""


def revision_note(prompt):
    """What a reviewer's change request looks like in the answer: "revised, round N, asked: <feedback>", or "" for a first attempt.
    N counts the earlier versions in <prior_artifacts> + 1, so each round of one Request answers differently."""
    feedback = revision_feedback(prompt)
    if not feedback:
        return ""
    after = prompt.split("\n</request>\n", 1)[1]
    prior = re.search(r"\n<prior_artifacts>\n(.*?)\n</prior_artifacts>\n", after, re.S)
    earlier = len(re.findall(r"^--- artifact \d+ \(kind=", prior.group(1), re.M)) if prior else 0
    asked = " ".join(feedback.split())[:60]
    return f" [revised, round {earlier + 1}, asked: {asked}]"


# A change request whose text carries this code fails the FIRST time it is asked and succeeds afterwards (a marker file per
# distinct feedback in the state dir). Lets the analysis-revision suite prove a failed revision can be retried without
# retyping the ask: the retry has the same feedback, so it answers.
FAIL_ONCE_TRIGGER = "[stub:fail-once]"


# A change request carrying this code is answered after a pause, so a suite can send a second change request while the first one
# is still running (the agent strips FAKE_* from the environment, hence the fixed default).
SLOW_TRIGGER = "[stub:slow]"


def slow_seconds():
    try:
        return max(0.0, float(os.environ.get("FAKE_CLAUDE_SLOW_SECONDS", "6")))
    except ValueError:
        return 6.0


def pause_if_slow(prompt):
    if SLOW_TRIGGER in revision_feedback(prompt):
        time.sleep(slow_seconds())


def fail_once(prompt):
    feedback = revision_feedback(prompt)
    if FAIL_ONCE_TRIGGER not in feedback:
        return False
    marker = os.path.join(state_dir(), "fail-once-" + hashlib.sha1(feedback.encode("utf-8")).hexdigest()[:16])
    if os.path.exists(marker):
        return False
    try:
        os.makedirs(state_dir(), exist_ok=True)
        open(marker, "w").close()
    except OSError:
        return False  # cannot remember the failure: answering beats failing forever
    return True


def fail_plan_next():
    """What the file `fail_plan_next` asks for this Plan prompt ("error", "invalid" or "slow"), or "". Consumes one of its count."""
    path = os.path.join(state_dir(), "fail_plan_next")
    try:
        with open(path) as fh:
            count, _, kind = fh.read().strip().partition(":")
        left = int(count)
    except (OSError, ValueError):
        return ""
    kind = kind.strip() or "error"
    if left <= 0 or kind not in ("error", "invalid", "slow"):
        return ""
    try:
        with open(path, "w") as fh:
            fh.write(f"{left - 1}:{kind}")
    except OSError:
        return ""  # cannot count the failure down: answering beats failing forever
    return kind


def language_directive(prompt):
    """vi, en or "": the code of the `Output language: <Name>.` line that request-service puts before <request>. Only that part is read:
    the request text is untrusted and may quote the line."""
    if "\n<request>\n" not in prompt:
        return ""
    head = prompt.split("\n<request>\n", 1)[0]
    m = re.search(r"^Output language: (\w+)\.$", head, re.M)
    return LANGUAGE_CODES.get(m.group(1), "") if m else ""


