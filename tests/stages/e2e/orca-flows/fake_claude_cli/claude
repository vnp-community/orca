  auth                               Manage authentication
"""


def state_dir():
    return os.environ.get("FAKE_CLAUDE_STATE_DIR") or os.path.join(os.path.expanduser("~"), ".fake-claude")


def logged_in():
    env = os.environ.get("FAKE_CLAUDE_LOGGED_IN")
    if env is None:
        try:
            with open(os.path.join(state_dir(), "logged_in")) as fh:
                env = fh.read().strip()
        except OSError:
            return True
    return env.strip().lower() not in ("0", "false", "no", "off")


def record(kind, argv, stdin_bytes=0, extra=None):
    """Appends one line per invocation so a test can assert on the exact argv and cwd the agent used."""
    entry = {"ts": time.time(), "kind": kind, "argv": argv, "cwd": os.getcwd(), "stdinBytes": stdin_bytes}
    if kind == "print":  # only ai.complete must start in an empty scratch directory; probes run wherever the agent is
        try:
            entry["cwdEntries"] = sorted(os.listdir(os.getcwd()))[:50]
        except OSError:
            entry["cwdEntries"] = None
    entry.update(extra or {})
    try:
        os.makedirs(state_dir(), exist_ok=True)
        with open(os.path.join(state_dir(), "calls.jsonl"), "a") as fh:
            fh.write(json.dumps(entry) + "\n")
    except OSError:
        pass  # recording is best effort; the answer must not depend on it


def flag_value(argv, name):
    """Value after `name`; None when absent. An empty string is a real value (`--tools ""`)."""
    for i, a in enumerate(argv):
        if a == name and i + 1 < len(argv):
            return argv[i + 1]
        if a.startswith(name + "="):
            return a[len(name) + 1:]
    return None


def write_utf8(text):
    """Raw UTF-8 bytes, like the real CLI, whatever the locale of the agent's environment: Vietnamese must reach the agent unescaped."""
    sys.stdout.flush()
    sys.stdout.buffer.write(text.encode("utf-8"))
    sys.stdout.buffer.flush()


def emit(result_text, is_error=False, api_status=None, prompt_len=0):
    out = {
        "type": "result",
        "subtype": "error_during_execution" if is_error else "success",
        "is_error": is_error,
        "duration_ms": 1,
        "num_turns": 1,
        "result": result_text,
        "session_id": SESSION_ID,
        "usage": {"input_tokens": max(1, prompt_len // 4), "output_tokens": max(1, len(result_text) // 4)},
        "modelUsage": {MODEL: {}},
    }
    if api_status is not None:
        out["api_error_status"] = api_status
    write_utf8(json.dumps(out, ensure_ascii=False))
    return 1 if is_error else 0


