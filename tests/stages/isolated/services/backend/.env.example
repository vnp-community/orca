# Cấu hình cho bộ kiểm tra API backend-go (tests/backend).
# Sao chép thành tests/backend/.env rồi chỉnh. Biến môi trường của shell
# luôn ghi đè giá trị trong file này.

# URL public của api-gateway (không có dấu / cuối).
ORCA_API_BASE_URL=http://localhost:6768

# Tài khoản dùng để đăng nhập (POST /auth/local). Cần quyền admin để
# kiểm tra các route /admin/api và /v1/auth/users.
ORCA_ADMIN_EMAIL=admin@example.com
ORCA_ADMIN_PASSWORD=change-me

# (tuỳ chọn) Tài khoản user thường để kiểm tra phân quyền (403 trên /admin/api).
ORCA_USER_EMAIL=
ORCA_USER_PASSWORD=

# (tuỳ chọn) Fallback: nếu thiếu ORCA_ADMIN_* sẽ dùng BOOTSTRAP_ADMIN_* (deploy/dev/.env).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Timeout mỗi request (giây) và độ trễ giữa các request (ms) để tránh rate-limit.
ORCA_HTTP_TIMEOUT=20
ORCA_REQUEST_DELAY_MS=0

# Xác thực TLS (false khi dùng chứng chỉ tự ký).
ORCA_VERIFY_TLS=true

# URL WebSocket cho /ws (mặc định suy ra từ ORCA_API_BASE_URL).
ORCA_WS_URL=

# Secret bearer của Dev Server Agent (ORCA_AGENT_API_SECRET) — để kiểm tra /api/agent-token. Bỏ trống để bỏ qua.
ORCA_AGENT_API_SECRET=

# Bật các kiểm tra GHI dữ liệu (tạo user/project/task/...). Dữ liệu tạo ra
# có tiền tố ORCA_TEST_PREFIX và được dọn dẹp ở cuối. Đặt false để chỉ chạy GET/kiểm tra xác thực.
ORCA_ALLOW_WRITES=true
ORCA_TEST_PREFIX=apitest

# Bật probe TẤT CẢ kênh WebSocket (kể cả kênh ghi, args rỗng). Mặc định chỉ kênh chỉ-đọc.
ORCA_WS_PROBE_ALL=false
