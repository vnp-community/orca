# ── Build artifacts ──────────────────────────────────────────
dist/

# ── TLS certs (chứa private key) ─────────────────────────────
docker/nginx/certs/*.key
docker/nginx/certs/*.crt
docker/nginx/certs/*.pem

# ── SSH keys (PRIVATE key phải gitignore) ──────────────────
# Private key không commit
docker/orca/ssh/id_ed25519
# Public key + config + known_hosts có thể commit (không chứa secret)
# docker/orca/ssh/id_ed25519.pub
# docker/orca/ssh/config
# docker/orca/ssh/known_hosts

# ── Environment (chứa secrets) ───────────────────────────────
.env

# ── Logs ─────────────────────────────────────────────────────
*.log
