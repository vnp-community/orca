# ============================================================
# .env.example — Biến môi trường cho Orca Agent Deployment
# ============================================================
# Copy file này: cp .env.example .env
# Điền giá trị thực vào .env (KHÔNG commit .env vào git)
#
# Trước đây các biến này nằm trong deploy/dev/.env — đã tách riêng
# vì deploy/agent/ giờ là thư mục triển khai độc lập.
# Các biến liên quan tới bản thân Orca Server (ORCA_DOMAIN, DB, AI keys...)
# vẫn nằm ở deploy/dev/.env.example.
#
# deploy/dev/ giờ triển khai backend-go — chỉ frontend (nginx) và
# api-gateway được expose ra host, api-gateway là entrypoint duy nhất nên
# ORCA_HTTP_PORT ở đây nên trỏ vào API_GATEWAY_PUBLIC_PORT của deploy/dev
# (mặc định 8081, xem deploy/dev/.env.example), không phải FRONTEND_HTTP_PORT.
#
# ⚠️ CHƯA HOẠT ĐỘNG: backend-go chưa có route /agent (WS) hay handler
# /api/agent-token — infra-fleet-service/internal/adapter/devserveragent
# vẫn là stub trả ErrNotImplemented (Epic A trong
# backend-go/docs/execution-plan.md, chưa làm). Agent sẽ không connect/xác
# thực được cho tới khi Epic A xong.
# ============================================================

# ── Kết nối tới Orca Server (để agent lấy token + gửi handshake) ─
SERVER_HOST=172.20.2.39
ORCA_HTTP_PORT=6768
AGENT_ORCA_URL=wss://b15.openledger.vn/agent
# Secret để xác thực POST /api/agent-token (phải khớp ORCA_AGENT_API_SECRET trên Orca Server)
ORCA_AGENT_API_SECRET=

# ── SSH tới Dev Server đích (nơi agent.js sẽ chạy) ────────────
DEV_SERVER_HOST=172.20.2.31
DEV_SERVER_USER=ubuntu
DEV_SERVER_PORT=22
DEV_SERVER_LABEL=dev-local
DEV_SERVER_KEY=~/.ssh/id_ed25519
