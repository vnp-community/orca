# ── Orca Dev Agent — Environment Variables ────────────────────────
# File này chạy CHUNG với agent.js TRÊN dev server đích (không phải
# máy dùng để deploy) — copy nó lên remote host rồi đổi tên thành .env.
# Copy thành .env và điền giá trị phù hợp.
# Không commit .env vào git.

# ── Mode kết nối ──────────────────────────────────────────────────
# 'direct-websocket' : Agent kết nối VÀO Orca (khuyến nghị, không cần mở port)
# 'relay-websocket'  : Orca kết nối VÀO agent (cần mở AGENT_PORT)
MODE=direct-websocket

# ── direct-websocket ──────────────────────────────────────────────
# URL của Orca WebSocket server
# Why: nếu dev server này cùng LAN với Orca Server, dùng thẳng
# ws://<orca-lan-ip>:<API_GATEWAY_PUBLIC_PORT>/agent (deploy/dev/.env, mặc
# định 6768 — KHÔNG phải FRONTEND_HTTP_PORT, cổng nginx cho browser) thay vì
# domain công khai — tránh đi vòng ra internet và rớt kết nối giữa chừng do
# hop trung gian không ổn định.
# ⚠️ CHƯA HOẠT ĐỘNG trên backend-go: route /agent chưa tồn tại ở api-gateway
# (Epic A — backend-go/docs/execution-plan.md — vẫn là stub). Giữ nguyên
# domain/URL cũ cho tới khi Epic A xong.
ORCA_URL=wss://b15.openledger.vn/agent
# One-time token từ: bash deploy/agent/scripts/connect-agent.sh
AGENT_TOKEN=agt-dev-local-XXXXXXXXXXXXXXXXX

# ── relay-websocket (bỏ comment nếu dùng relay mode) ─────────────
# Port để Orca kết nối vào
# AGENT_PORT=6799
# AGENT_TOKEN=my-relay-shared-secret

# ── Chung ─────────────────────────────────────────────────────────
# ID của dev server này trong Orca (hiển thị trên UI)
DEV_SERVER_ID=dev-local

# Log level: 'info' | 'debug'
LOG_LEVEL=info

# Thư mục làm việc mặc định cho tools (claude, git, gh...)
# Mặc định: thư mục chứa agent.js
AGENT_WORK_DIR=/srv/projects/vnp-blc

# ── API Keys (nếu tools cần) ──────────────────────────────────────
# Claude Code tìm key theo thứ tự:
#   1. ANTHROPIC_API_KEY env var
#   2. ~/.claude/settings (đã login bằng claude auth login)
ANTHROPIC_API_KEY=

# GitHub token (nếu không dùng gh auth login)
# GITHUB_TOKEN=ghp_xxxx
# GH_TOKEN=ghp_xxxx

# ── TLS (chỉ dùng khi Orca dùng self-signed cert trong dev) ──────
# NODE_TLS_REJECT_UNAUTHORIZED=0
