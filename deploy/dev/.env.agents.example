# ============================================================
# .env.agents.example — Danh sách Dev Servers để deploy Agent
# ============================================================
# Copy file này: cp .env.agents.example .env.agents
# Điền IP thực vào .env.agents (KHÔNG commit vào git nếu chứa IP nội bộ)
#
# Format mỗi server:
#   AGENT_SERVER_<NAME>="user@host[:port] [label] [work_dir]"
#
# Các field (space-separated, label và work_dir là optional):
#   1. user@host[:port]  — SSH connection string (bắt buộc)
#   2. label             — tên hiển thị / devServerId trong Orca (default: NAME)
#   3. work_dir          — AGENT_WORK_DIR trên server (default: /srv/projects)
#
# ── Ví dụ ────────────────────────────────────────────────────

# Server dev chính của team backend
AGENT_SERVER_DEV01="ubuntu@172.20.2.31 dev-01 /home/ubuntu/projects"

# Server dev AI / ML
AGENT_SERVER_DEV02="ubuntu@172.20.2.37 dev-ai /home/ubuntu/projects"

# Server testing
AGENT_SERVER_TEST01="ubuntu@172.20.2.41 test-01 /home/ubuntu/projects"

# Server với port SSH tùy chỉnh
# AGENT_SERVER_REMOTE="ubuntu@10.0.0.5:2222 remote-dev /home/ubuntu"

# ── SSH key dùng chung cho tất cả servers ────────────────────
# Ghi đè SERVER_KEY từ .env nếu cần key riêng cho agents
# AGENT_SSH_KEY=~/.ssh/id_ed25519_agents

# ── Token API (nếu không dùng ORCA_AGENT_API_SECRET từ .env) ─
# AGENT_API_SECRET=your-api-secret-here

# ── Timeout khi deploy song song (giây, default: 120) ─────────
# AGENT_DEPLOY_TIMEOUT=120
