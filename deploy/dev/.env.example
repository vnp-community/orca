# ============================================================
# .env.example — Biến môi trường cho Orca Dev Deployment
# ============================================================
# Copy file này: cp .env.example .env
# Điền giá trị thực vào .env (KHÔNG commit .env vào git)
# ============================================================

# ── Orca Server ──────────────────────────────────────────────
# Domain mà developer dùng để kết nối (phải trỏ vào server này)
# Browser URL sẽ là: https://ORCA_DOMAIN/
ORCA_DOMAIN=b15.openledger.vn

# Port Orca WebSocket/RPC bên trong container (default: 6768)
ORCA_PORT=6768

# Port HTTP (web UI static files + /health/* endpoints, default: 6769)
ORCA_HTTP_PORT=6769

# Version tag cho Docker image
ORCA_VERSION=1.4.138

# ── Multi-User & Authentication ───────────────────────────────
# Bật multi-user mode: mỗi user được fork thành process riêng
# Set=1 để enable login screen + per-user isolation
ORCA_MULTI_USER=0

# Auth mode: 'none' (single-user, no login) | 'local' (email+password)
# 'sso' sẽ được hỗ trợ ở Phase 2
ORCA_AUTH_MODE=none

# Admin user (chỉ dùng khi ORCA_MULTI_USER=1)
# Nếu để trống → auto-generate random password, in ra stdout lần đầu boot
# ORCA_ADMIN_EMAIL=admin@orca.local
# ORCA_ADMIN_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ── Nginx ────────────────────────────────────────────────────
# Port expose ra ngoài (Nginx lắng nghe)
HTTP_PORT=80
HTTPS_PORT=443


# ── Database Configuration ────────────────────────────────────
# Mặc định: SQLite (không cần config thêm)
# Uncomment để dùng external database:

# URL-form (khuyến nghị — một biến duy nhất, password included):
# ORCA_DB_URL=mysql://orca_user:CHANGE_ME@localhost:3306/orca_dev
# ORCA_DB_URL=postgresql://orca_user:CHANGE_ME@localhost:5432/orca_dev
# ORCA_DB_URL=tidb://orca_user:CHANGE_ME@localhost:4000/orca_dev

# Hoặc structured form (dễ quản lý secrets riêng):
# ORCA_DB_DIALECT=mysql
# ORCA_DB_HOST=localhost
# ORCA_DB_PORT=3306
# ORCA_DB_NAME=orca_dev
# ORCA_DB_USER=orca_user
# ORCA_DB_PASSWORD=CHANGE_ME   # ← keep secret, never commit

# ── AI API Keys (tuỳ chọn — developer có thể set qua UI) ─────
# Để trống nếu muốn mỗi developer tự set key trong Orca UI
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── SSH sync (dùng bởi sync-to-server.sh) ────────────────────
# Host của Orca Server (để rsync lên)
# Host của Orca Server — nơi container chạy (deploy target)
SERVER_HOST=172.20.2.39

# Remote dev server — máy developer, Orca sẽ SSH vào đây (fleet member)
# DEV_SERVER_HOST=172.20.2.31

# SSH user trên server (cần sudo-less docker access)
SERVER_USER=ubuntu

# Path tới SSH private key (trên máy local)
SERVER_KEY=~/.ssh/id_ed25519

# SSH port
SERVER_PORT=22

# Thư mục deploy trên server
SERVER_DEPLOY=~/orca-deploy

# ── Container config (dùng bởi get-pairing-url.sh) ───────────
# Tên Docker container Orca Server
ORCA_CONTAINER_NAME=orca-server

# Data directory trong container (chứa DB, keypair, device registry)
ORCA_DATA_PATH=/data/orca

# ── Dev Server / Agent deployment ─────────────────────────────
# Đã chuyển sang deploy/agent/.env.example (DEV_SERVER_HOST, AGENT_ORCA_URL,
# ORCA_AGENT_API_SECRET, ...) — deploy/agent/ giờ là thư mục triển khai
# agent độc lập, tách khỏi backend/nginx ở đây.

# ── Fleet Monitoring ──────────────────────────────────────────
# Bật Prometheus metrics endpoint (GET /metrics)
ORCA_FLEET_METRICS_ENABLED=false
# Webhook URL để nhận alert khi fleet server status thay đổi
# ORCA_FLEET_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# Health check interval (ms) — default: 60000 (60s)
# ORCA_FLEET_HEALTH_CHECK_INTERVAL_MS=60000
