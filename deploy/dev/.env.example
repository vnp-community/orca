# ============================================================
# .env.example — deploy/dev/ config (backend-go + frontend)
# ============================================================
# Copy: cp .env.example .env — do NOT commit .env (see .gitignore).
# ============================================================

# Explicit Compose project name — see deploy/old/.env.example's comment on
# why this matters (avoids two unrelated stacks both named after their
# parent directory colliding on the same host). This directory's project
# name is set via docker-compose.yml's top-level `name:` field already
# (orca-go) — this var is not currently read by anything, kept here only if
# a future override is needed.
# COMPOSE_PROJECT_NAME=orca-go

# ── Postgres ───────────────────────────────────────────────
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ── Vault ────────────────────────────────────────────────────
# Dev-mode root token — see ../README.md's "Known limitations" section.
# NOT a production Vault setup (in-memory, single node, no auto-unseal).
VAULT_TOKEN=dev-root-token

# ── Observability (optional) ──────────────────────────────────
# OTLP collector endpoint — leave empty to disable trace export
# (common/tracing still creates spans locally either way). Format is
# host:port, no scheme (otlptracegrpc.WithEndpoint expects gRPC dial
# target syntax, not a URL) — see common/tracing/tracing.go.
# The shared VNP observability stack (vnp-domain/observability/) runs its
# OTel Collector's gRPC OTLP receiver on the SAME host as this deploy
# (172.20.2.39:4317, per vnp-domain/guides/observability-integration.md
# and docker-compose.server.yml's port mapping) — reach it via the host's
# LAN IP, not `localhost` (orca's containers are on a different bridge
# network, orca-go-net, than the observability stack's):
#   OTLP_ENDPOINT=172.20.2.39:4317
OTLP_ENDPOINT=

# ── Public ports (host-exposed) ───────────────────────────────
# Only the frontend (nginx) and api-gateway are host-exposed — every other
# service is reachable only on the internal orca-go-net bridge network, per
# specs/backend-go/architecture/08-inter-service-communication.md ("only
# api-gateway has an external-facing listener").
FRONTEND_HTTP_PORT=8080
API_GATEWAY_PUBLIC_PORT=8081

# PUBLIC_BASE_URL is the externally-reachable scheme+host this deployment
# is actually served at (e.g. https://app.example.com) — distinct from the
# host:port bindings above, since a reverse proxy/TLS terminator in front
# of this stack usually means the public URL isn't literally
# "http://<host>:${API_GATEWAY_PUBLIC_PORT}". Required for SSO (see the
# "SSO" section below) — api-gateway builds the OAuth2/OIDC redirect_uri as
# exactly "${PUBLIC_BASE_URL}/auth/callback", which must match what's
# registered with each IdP byte-for-byte. Leave empty to keep SSO disabled
# (GET /auth/sso/{provider} degrades to a 501, same as before this var
# existed) — local-password login never depends on this.
PUBLIC_BASE_URL=

# ── SSH sync (used by scripts/sync-to-server.sh + migrate.sh --remote) ──
SERVER_HOST=
SERVER_USER=ubuntu
SERVER_KEY=~/.ssh/id_ed25519
SERVER_PORT=22
SERVER_DEPLOY=~/orca-go-deploy

# ── Build (used by scripts/build-local.sh) ────────────────────
# Stamped into each binary via -ldflags -X main.version=... — informational
# only, shown in each service's startup log line.
# ORCA_GO_VERSION=0.1.0

# ── Dev Server Agent auth (infra-fleet-service) ───────────────
# Shared secret gating POST/GET /api/agent-token, proxied in from
# api-gateway (agent_proxy_routes.go) to infra-fleet-service's /agent +
# /api/agent-token — must match deploy/agent/.env's ORCA_AGENT_API_SECRET
# exactly, or every Dev Server Agent connection is rejected fail-secure.
# Empty disables agent token issuance entirely (logged as a warning, not
# fatal — infra-fleet-service's other RPCs are unaffected).
ORCA_AGENT_API_SECRET=

# ── First-boot admin bootstrap (auth-service) ─────────────────
# Runs ONCE, at auth-service startup, and only if no user exists anywhere
# yet (services/auth-service/internal/usecase/bootstrap.go) — safe to leave
# set permanently, it's a no-op after the first successful run.
# Leave BOOTSTRAP_ADMIN_PASSWORD empty to auto-generate one instead (logged
# once to auth-service's stdout at first boot, never stored in plaintext).
# To force bootstrap to re-run with a NEW password after it already ran
# once (e.g. you set this after the auto-generated admin was already
# created), delete the existing row first:
#   docker compose exec postgres psql -U orca -d auth \
#     -c "DELETE FROM auth.users WHERE email='admin@example.com'"
#   docker compose up -d --force-recreate auth-service
# BOOTSTRAP_COMPANY_NAME (optional) — tenant-service now originates the
# tenant id itself via a CreateCompany call bootstrap.go makes at startup,
# so there's no id to pin here anymore (replaces the old
# BOOTSTRAP_TENANT_ID, which bootstrap.go no longer reads). Leave empty to
# fall back to a name derived from BOOTSTRAP_ADMIN_EMAIL.
BOOTSTRAP_COMPANY_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ── SSO (CR-LOGIN-001: GitHub / Google / generic OIDC) ────────
# All optional — an unconfigured provider (empty SSO_*_CLIENT_ID) is simply
# absent from the login page; local-password login (POST /auth/local)
# always keeps working regardless of anything below. See PUBLIC_BASE_URL
# above (required for any of this to take effect) and
# services/auth-service/README.md's SSO entry for the full account-linking
# policy (returning identity / auto-link a verified email to an existing
# local account / reject an unverified-email collision / provision a
# brand-new user — role always "user", SSO never auto-admins). A brand-new
# SSO user's tenant is resolved automatically ONLY when this deployment has
# exactly one company/tenant — see that same README entry's "Known gaps".
#
# AUTH_MODE: "both" (default, safe) shows local + any configured SSO
# providers; "local" hides all SSO providers even if configured below;
# "sso" hides the local password form (POST /auth/local route itself stays
# mounted either way).
AUTH_MODE=both

# SSO_STATE_SECRET HMAC-signs the short-lived (15 min) OAuth2/OIDC state
# token (auth-service's internal/adapter/oauthstate) — set to a long random
# value in any real deployment; an empty value produces forgeable state
# tokens (auth-service still boots, but SSO must not be relied on until
# this is set). Auth-service-only — never needed on api-gateway.
SSO_STATE_SECRET=

# GitHub OAuth App (https://github.com/settings/developers) — Authorization
# callback URL must be exactly "${PUBLIC_BASE_URL}/auth/callback".
SSO_GITHUB_CLIENT_ID=
SSO_GITHUB_CLIENT_SECRET=

# Google OAuth 2.0 Client (console.cloud.google.com → APIs & Services →
# Credentials) — Authorized redirect URI must be exactly
# "${PUBLIC_BASE_URL}/auth/callback". Google's endpoints are fixed
# well-known constants in auth-service (no discovery URL needed).
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=

# Generic/self-hosted OIDC (Keycloak-compatible — labeled "keycloak" on the
# login page, see AGENTS.md's provider-naming note). SSO_OIDC_DISCOVERY_URL
# is fetched ONCE at auth-service startup
# (internal/adapter/oauth.FetchDiscoveryDocument) — e.g. for a Keycloak
# realm: "https://<keycloak-host>/realms/<realm>/.well-known/openid-configuration".
# auth-service fails to start if this is set but unreachable/malformed;
# leave both empty to skip generic OIDC entirely.
SSO_OIDC_CLIENT_ID=
SSO_OIDC_CLIENT_SECRET=
SSO_OIDC_DISCOVERY_URL=

# ============================================================
# MCP (Model Context Protocol) — AI agents operating Orca
# ============================================================
# Process-level master switch. OFF by default: /mcp is not mounted and the
# mcp.* UI channels answer MCP_DISABLED. Turn on only after reading README.md's
# "MCP rollout" section (Vault policy, DB, secrets, TLS front proxy).
MCP_ENABLED=false

# New tenants get MCP enabled by default (admins can still switch it off per
# tenant). This never loosens risk defaults: exec/destructive tools still need
# approval and the hard-deny list still applies.
MCP_TENANT_DEFAULT_ENABLED=true

# Public origin of the UI, no path. Falls back to PUBLIC_BASE_URL above, so
# normally leave empty.
MCP_PUBLIC_BASE_URL=

# Browser WebSocket Origin allow-list (comma-separated exact origins). Empty =
# defaults to PUBLIC_BASE_URL. Set it only to ADD addresses users reach the UI
# by (e.g. "https://orca.example.com,http://10.0.0.5:6769"); include the public
# URL again if you override it. Visits by raw http://ip:port work without being
# listed (nginx forwards the port in Host); other origins get HTTP 403.
WS_ALLOWED_ORIGINS=

# Generated for you on the server by scripts/ensure-mcp-env.sh (run by
# sync-to-server.sh). Never commit real values. They guard internal-only gRPC
# calls on the flat docker network, so keep them private and distinct.
#   MCP_INTERNAL_CALLER_TOKEN        mcp-service  <-> api-gateway
#   OAUTH_INTERNAL_CALLER_TOKEN      auth-service <-> mcp-service
#   AUTH_MCP_PRINCIPAL_CALLER_TOKEN  auth-service <-> api-gateway
#   MCP_CURSOR_KEY                   HMAC key for MCP pagination cursors
#   OAUTH_RESOURCE_URL               <PUBLIC_BASE_URL>/mcp (derived)
MCP_INTERNAL_CALLER_TOKEN=
OAUTH_INTERNAL_CALLER_TOKEN=
AUTH_MCP_PRINCIPAL_CALLER_TOKEN=
MCP_CURSOR_KEY=
OAUTH_RESOURCE_URL=

# Allow MCP clients to self-register (RFC 7591). Disable to allow only clients an
# admin registered.
OAUTH_DCR_ENABLED=true

# Tool packs exposed to agents: 1 = read, 2 = reversible writes, 3 = exec
# (terminal/agent/workflow), 4 = destructive/admin. Default is read-only; higher
# packs are still gated by per-tool approval policy.
MCP_TOOL_PACKS_ENABLED=1

# Web Push (VAPID) contact: a mailto: or https: URL. Empty = PUBLIC_BASE_URL.
# Also needs scripts/provision-vapid-key.sh (per-tenant Vault key).
VAPID_SUBJECT=

# Running stdio MCP servers from the external-server registry executes code on
# the dev host. Keep off unless you accept that.
MCP_EXTERNAL_STDIO_ENABLED=false
