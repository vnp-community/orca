# orca-vault-init.service — re-run vault-init after every host boot.
#
# Why this exists: Vault runs in DEV MODE here (docker-compose.yml's `vault`
# service — in-memory only, no persistent storage; see the compose file's own
# "Vault dev-mode" comment for why that tradeoff is accepted on this deploy).
# Every time the `vault` container restarts — including a plain host reboot,
# where Docker brings every `restart: unless-stopped` container back on its
# own — Vault comes back completely EMPTY: the `transit/` engine (auth-service's
# JWT signing key) and `credential-secrets/` KV mount (credential-broker-service)
# are gone until `vault-init` re-enables them.
#
# `vault-init` itself is a one-shot compose service (`restart: "no"`,
# `profiles: ["migrate"]`-style gating via its own `command`, idempotent —
# checks `vault secrets list` before enabling). That's exactly why it does
# NOT self-heal on a bare reboot: Docker only auto-restarts containers whose
# restart policy says to, and a `restart: "no"` job that already exited
# successfully once is left alone forever after that — it is never
# re-invoked just because `vault` itself came back fresh. `docker compose up
# -d` (the normal deploy flow, scripts/sync-to-server.sh) DOES pick this up
# correctly, since it always re-evaluates every service; a bare reboot with
# nobody running a deploy afterward does not.
#
# Confirmed live 2026-09-03: after 172.20.2.39 rebooted (unrelated memory
# exhaustion incident), auth-service/credential-broker-service crash-looped
# for hours on `GITGATEWAY_...`-adjacent Vault 404s
# ("no handler for route \"transit/keys/jwt-signing\"") until vault-init was
# re-run by hand. This unit closes that gap going forward.
#
# `docker compose run --rm vault-init` reuses that service's own
# `depends_on: vault: {condition: service_healthy}` — so this unit does not
# need to itself wait for Vault; compose does that for the `run` invocation
# too. Retries with backoff (Restart=on-failure) cover the case where this
# unit starts to run before Docker has finished bringing every container
# back after a fresh boot.
#
# Install (one-time, on the server — not run automatically by
# scripts/sync-to-server.sh, since installing a systemd unit needs root and
# is a one-time host-provisioning step, not a per-deploy action):
#   sudo cp deploy/dev/systemd/orca-vault-init.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now orca-vault-init.service
#
# Verify: sudo systemctl status orca-vault-init.service ; journalctl -u orca-vault-init.service

[Unit]
Description=Orca dev deploy — re-enable Vault transit/credential-secrets after boot (vault runs in ephemeral dev mode)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/ubuntu/orca-go-deploy
ExecStart=/usr/bin/docker compose run --rm vault-init
# Retry on failure — covers the window right after boot where this unit may
# start before every container in the compose stack has finished coming
# back up on its own restart policy.
Restart=on-failure
RestartSec=10
StartLimitIntervalSec=180
StartLimitBurst=12

[Install]
WantedBy=multi-user.target
