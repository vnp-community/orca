# Orca Server Production — Environment Variables
# Copy to .env and customize before running docker compose
#
# Usage:
#   cp deploy/prod/.env.example deploy/prod/.env
#   docker compose -f deploy/prod/docker-compose.yml --env-file deploy/prod/.env up -d

# ── Image Configuration ────────────────────────────────────────────────────────
# Docker image tag (set by CI/CD pipeline)
ORCA_VERSION=latest
ORCA_IMAGE=vnpblc/orca-server

# ── Port Mapping ───────────────────────────────────────────────────────────────
# Host ports exposed to the outside (adjust if ports are already in use)
ORCA_RPC_PORT=6768    # WebSocket/RPC — frontend clients
ORCA_WEB_PORT=6769    # HTTP — web UI + admin SPA (/admin/) + health endpoints

# ── Multi-User & Authentication ────────────────────────────────────────────────
# Set=1 để enable login screen + per-user process isolation
# Set=0 (default) = single-user PairCode mode (backward compat)
ORCA_MULTI_USER=0

# Auth mode when ORCA_MULTI_USER=1:
#   'none'  = no auth (unsafe, dev only)
#   'local' = email+password (Phase 1 — available now)
#   'sso'   = OIDC/OAuth2 (Phase 2 — coming soon)
ORCA_AUTH_MODE=none

# Admin user credentials (only when ORCA_MULTI_USER=1)
# Leave empty → auto-generate random password, printed to stdout on first boot
# ORCA_ADMIN_EMAIL=admin@your-company.com
# ORCA_ADMIN_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD   # ← never commit

# ── SSH Configuration ──────────────────────────────────────────────────────────
# SSH key for Orca Server to connect to fleet dev servers
# Mount the key as a Docker secret or via volume
# SSH_KEY_PATH=/run/secrets/orca_ssh_key

# ── Fleet Monitoring ───────────────────────────────────────────────────────────
# Enable Prometheus metrics endpoint: GET /metrics
ORCA_FLEET_METRICS_ENABLED=false
# Webhook URL for fleet status change alerts (Slack, Teams, custom)
# ORCA_FLEET_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# Health check interval in milliseconds (default: 60000 = 60s)
# ORCA_FLEET_HEALTH_CHECK_INTERVAL_MS=60000

# ── Database Configuration ─────────────────────────────────────────────────────
# By default, Orca uses SQLite (no config needed).
# Uncomment and fill in ONE of the following for external databases:

# URL-form (recommended — single env var, password included):
# ORCA_DB_URL=mysql://orca_user:CHANGE_ME@localhost:3306/orca_prod
# ORCA_DB_URL=postgresql://orca_user:CHANGE_ME@localhost:5432/orca_prod
# ORCA_DB_URL=tidb://orca_user:CHANGE_ME@localhost:4000/orca_prod

# Or structured form (easier to manage secrets separately):
# ORCA_DB_DIALECT=postgresql
# ORCA_DB_HOST=db.company.com
# ORCA_DB_PORT=5432
# ORCA_DB_NAME=orca_prod
# ORCA_DB_USER=orca_user
# ORCA_DB_PASSWORD=CHANGE_ME        # ← keep secret, never commit
# ORCA_DB_SSL=true
# ORCA_DB_POOL_MAX=10
# ORCA_DB_POOL_MIN=2

# ── Observability ──────────────────────────────────────────────────────────────
# Node.js environment
NODE_ENV=production

# Log level (optional — defaults to 'info')
# LOG_LEVEL=info

# ── AI API Keys (optional — can also be set per-user via Orca UI) ──────────────
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...

